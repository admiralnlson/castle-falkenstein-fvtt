<div class="{{cssClass}}">

  <header class="sheet-header">
    <div class="header-fields">
      <div class="flexcol">
        <div class="grid grid-6col spell-sheet-header">
          <label class="resource-label">{{localize "castle-falkenstein.spell.spell"}}:</label>
          <input name="name" type="text" value="{{item.name}}" placeholder="Name" />
          <select name="system.suit" class="suit-select">
            {{selectOptions CASTLE_FALKENSTEIN.cardSuitsSymbols selected=system.suit localize=false}}
          </select>
          <span></span>
          <label class="resource-label">{{localize "castle-falkenstein.spell.thaumicLevel"}}:</label>
          <input class="thaumic-level" name="system.level" type="number" min="0" value="{{system.level}}" placeholder="" />
        </div>
      </div>
    </div>
  </header>


  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="tab-link {{tabs.description.cssClass}}" data-action="tab" data-group="primary" data-tab="description">{{localize "castle-falkenstein.description"}}</a>
    <a class="tab-link {{tabs.icon.cssClass}}" data-action="tab" data-group="primary" data-tab="icon">{{localize "castle-falkenstein.icon"}}</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
      {{formInput fields.description value=source.system.description enriched=enrichedDescription toggled=true}}
    </div>

    {{!-- Icon Tab --}}
    <div class="tab {{tabs.icon.cssClass}}" data-group="primary" data-tab="icon">
      <center><img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" alt="{{item.name}}" height="100" width="100"/></center>
    </div>

  </section>
</div>
